{
  "name": "quietkey",
  "version": "1.0.0",
  "private": true,
  "description": "Private, on-device message encryption",
  "author": "veerblox123",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:desktop": "electron-builder",
    "build:desktop:windows": "electron-builder --win nsis --x64",
    "build:desktop:linux": "electron-builder --linux AppImage deb --x64",
    "build:desktop:mac": "electron-builder --mac dmg zip",
    "build:web": "node scripts/prepare-web.mjs",
    "build:android": "npm run build:web && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "electron": "44.5.1",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.veerblox.quietkey",
    "productName": "QuietKey",
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage", "deb"]
    }
  }
}
